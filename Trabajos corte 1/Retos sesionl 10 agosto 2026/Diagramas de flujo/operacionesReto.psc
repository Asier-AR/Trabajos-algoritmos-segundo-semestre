Algoritmo operaciones
	Escribir "Ingrese los 2 numeros que desea operar"
	Leer numero1
	Leer numero2
	suma = numero1+numero2
	Escribir "La suma entre ", numero1 " y ", numero2, " es ", suma
	resta = numero1-numero2
	Escribir "La resta entre ", numero1 " y ", numero2 " es ",resta
	multiplicacion = numero1*numero2
	Escribir "La multiplicacion entre ", numero1, " y ", numero2, " es ", multiplicacion
	division = numero1/numero2
	Escribir "La operacion ",numero1 "/", numero2," es ", division
	potenciacion = numero1 ^ numero2
	Escribir "La potenciacion de ",numero1 "^", numero2, " es ", potenciacion
	raizCuadrada1 = raiz (numero1)
	Escribir "La raiz cuadrada de ", numero1 " es ", raizCuadrada1
	raizCuadrada2 = raiz (numero2)
	Escribir "La raiz cuadrada de ", numero2 " es ", raizCuadrada2
FinAlgoritmo
